# Node modules (always ignore)
**/node_modules/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Testing / Coverage
coverage/
.nyc_output/
*.lcov

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables & secrets
.env
.env.*.local

# OS / Editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Package manager-specific
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# TypeScript-specific
*.tsbuildinfo

# Optional: macOS-specific
.AppleDouble
.LSOverride

# Optional: test snapshots (if not committed)
__snapshots__/

# Optional: Turbo / Nx / monorepo tools
.turbo/
.cache/